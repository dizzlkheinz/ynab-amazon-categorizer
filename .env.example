# YNAB Amazon Categorizer Configuration
# Copy this file to '.env' and fill in your values

# Required: Your YNAB Personal Access Token
# Get this from: https://app.ynab.com/settings/developer
YNAB_API_KEY=your_api_key_here

# Required: Your YNAB Budget ID
# Find this in your YNAB URL: https://app.ynab.com/[budget_id]/budget
YNAB_BUDGET_ID=your_budget_id_here

# Optional: Specific Account ID to process (leave as 'none' to process all accounts)
# Find this in your YNAB URL when viewing an account
YNAB_ACCOUNT_ID=none

# Optional: Amazon domain used for generated order links (default: amazon.ca)
# AMAZON_DOMAIN=amazon.ca

# Optional: Sales tax rates applied to pre-tax split prices (defaults: 0.09 and 0.045)
# YNAB_DEFAULT_TAX_RATE=0.09
# YNAB_GROCERY_TAX_RATE=0.045

# Optional: Skip the split prompt when an order does not have multiple items
# YNAB_SKIP_SPLIT_PROMPT_SINGLE_ITEM=false
